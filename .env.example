# axonri-banking .env.example
# Copy to .env and fill in values. Never commit .env.

# LLM
LLM_BACKEND=llamacpp          # llamacpp | ollama
LLM_HOST_DETECT=auto          # auto-detects LLM host at startup
LLM_HOST=host.docker.internal # fallback if auto-detect fails
LLM_PORT=8080                 # 8080=llama.cpp, 11434=ollama
LLM_MODEL=qwen3               # model name (matches ollama pull name)

# Qdrant
QDRANT_HOST=axonri_qdrant
QDRANT_PORT=6333

# Data
DB_PATH=/data/axonri.db
CORPUS_DIR=/data/corpus
VECTORS_DIR=/data/vectors
LOG_DIR=/data/logs

# STT
WHISPER_MODEL=small           # tiny|base|small|medium

# Admin
AXONRI_ADMIN_PASSWORD=change_me_now   # CHANGE THIS
